{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Star Wars Mainline Canon Timeline Order (v2)",
  "description": "An array of films and television episodes in ascending timeline_order.",
  "type": "array",
  "items": { "$ref": "#/$defs/entry" },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": { "type": "string", "pattern": "\\S" },
    "year": { "type": "integer", "minimum": 0 },
    "era": { "enum": ["BBY", "ABY"] },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "timeline_order", "media_type", "series_id", "series_title",
        "item_title", "season_number", "episode_number", "date_label",
        "date_start_year", "date_start_era", "date_end_year", "date_end_era",
        "date_certainty", "source_url", "notes"
      ],
      "properties": {
        "id": { "type": "string", "description": "Stable identifier independent of watch order." },
        "timeline_order": { "$ref": "#/$defs/positiveInteger", "description": "One-based watch position." },
        "media_type": { "enum": ["film", "tv_episode"] },
        "series_id": { "anyOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
        "series_title": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "item_title": { "$ref": "#/$defs/text" },
        "season_number": { "anyOf": [{ "$ref": "#/$defs/positiveInteger" }, { "type": "null" }] },
        "episode_number": { "anyOf": [{ "$ref": "#/$defs/positiveInteger" }, { "type": "null" }] },
        "date_label": { "$ref": "#/$defs/text", "pattern": "^(?:~?[0-9]+ (?:BBY|ABY)|[0-9]+~[0-9]+ (?:BBY|ABY)|~[0-9]+-[0-9]+ (?:BBY|ABY)|0 BBY - 0 ABY)$", "description": "Strict in-universe date syntax; estimates use ASCII ~ and approximate ranges use ASCII hyphen." },
        "date_start_year": { "anyOf": [{ "$ref": "#/$defs/year" }, { "type": "null" }] },
        "date_start_era": { "anyOf": [{ "$ref": "#/$defs/era" }, { "type": "null" }] },
        "date_end_year": { "anyOf": [{ "$ref": "#/$defs/year" }, { "type": "null" }] },
        "date_end_era": { "anyOf": [{ "$ref": "#/$defs/era" }, { "type": "null" }] },
        "date_certainty": { "enum": ["exact", "approximate", "range", "on_or_after", "unknown"] },
        "source_url": { "type": ["string", "null"], "format": "uri" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S", "description": "Spoiler-free film or episode premise, at most 200 characters including spaces and punctuation." }
      },
      "allOf": [
        {
          "if": { "properties": { "media_type": { "const": "tv_episode" } } },
          "then": {
            "properties": {
              "id": { "pattern": "^tv:[a-z0-9]+(-[a-z0-9]+)*:s[0-9]{2,}e[0-9]{2,}$" },
              "series_id": { "type": "string" },
              "series_title": { "type": "string" },
              "season_number": { "type": "integer" },
              "episode_number": { "type": "integer" }
            }
          },
          "else": {
            "properties": {
              "id": { "pattern": "^film:[a-z0-9]+(-[a-z0-9]+)*$" },
              "series_id": { "type": "null" },
              "series_title": { "type": "null" },
              "season_number": { "type": "null" },
              "episode_number": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "date_certainty": { "const": "unknown" } } },
          "then": {
            "properties": {
              "date_start_year": { "type": "null" },
              "date_start_era": { "type": "null" },
              "date_end_year": { "type": "null" },
              "date_end_era": { "type": "null" }
            }
          },
          "else": {
            "if": { "properties": { "date_certainty": { "const": "on_or_after" } } },
            "then": {
              "properties": {
                "date_start_year": { "type": "integer" },
                "date_start_era": { "type": "string" },
                "date_end_year": { "type": "null" },
                "date_end_era": { "type": "null" }
              }
            },
            "else": {
              "properties": {
                "date_start_year": { "type": "integer" },
                "date_start_era": { "type": "string" },
                "date_end_year": { "type": "integer" },
                "date_end_era": { "type": "string" }
              }
            }
          }
        }
      ]
    }
  }
}
